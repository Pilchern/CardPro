# eBay developer credentials (api.ebay.com -> create a free developer account,
# create an application, use the production "Client ID" / "Client Secret").
# OPTIONAL: leave these as the placeholder values (or delete the lines) if you
# don't have eBay API access yet -- the scraper will fall back to the eBay
# email-alerts path (if enabled in config/settings.json) or Craigslist links
# only, rather than failing. See README "eBay account declined".
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret

# Gmail sending account. GMAIL_APP_PASSWORD is a 16-character App Password,
# NOT your normal Gmail password. Generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be enabled on the account first). Used for both sending the daily email
# (SMTP) and, if the eBay email-alerts path is enabled, reading eBay's
# saved-search alert emails out of this same inbox (IMAP) -- one credential,
# both uses, App Passwords work for both.
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Who the daily report gets sent to. Defaults to GMAIL_ADDRESS if omitted.
EMAIL_TO=you@example.com
